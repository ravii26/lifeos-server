generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  identity       Identity?
  settings       UserSettings?
  areas          Area[]
  goals          Goal[]
  projects       Project[]
  tasks          Task[]
  habits         Habit[]
  habitLogs      HabitLog[]
  calendarBlocks CalendarBlock[]
  focusSessions  FocusSession[]
  topics         Topic[]
  notebooks      Notebook[]
  resources      Resource[]
  notes          Note[]
  vaultItems     VaultItem[]
  captures       Capture[]
  reviews        Review[]
  insightReviews InsightReview[]
  behaviorLogs   BehaviorLog[]
  entityLinks    EntityLink[]
  documents            Document[]
  documentChunks       DocumentChunk[]
  documentSuggestions  DocumentSuggestion[]
  knowledgeChunks      KnowledgeChunk[]
}

model Identity {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // All optional — user fills gradually
  personality String?
  values      String[]
  strengths   String[]
  weaknesses  String[]
  purpose     String?

  // Renamed to feel more human
  thisYearGoal String? // "What do you want to achieve this year?"
  bigPicture   String? // "Where do you want to be in 5 years?"
  lifeVision   String? // "What does your ideal life look like?"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  type      AreaType @default(PRIMARY)
  color     String
  icon      String
  order     Int
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  goals          Goal[]
  projects       Project[]
  tasks          Task[]
  habits         Habit[]
  calendarBlocks CalendarBlock[]
  topics         Topic[]
  scoreSnapshots AreaScoreSnapshot[]

  @@index([userId])
}

enum AreaType {
  PRIMARY
  MAINTENANCE
}

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      GoalStatus @default(ACTIVE)
  deadline    DateTime?

  // Decision Engine — focus management. Only a small number of goals may be
  // ACTIVE at once (see MAX_ACTIVE_GOALS). Everything else lives as PARKED:
  // still here, queryable, but excluded from the daily "what should I do now"
  // surface so the user is never spread thin. These timestamps power the UX
  // ("active for 6 days", "parked 3 weeks ago") and ordering.
  activatedAt DateTime?
  parkedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects Project[]
  tasks    Task[]

  @@index([userId, status])
}

model Project {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String
  area   Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id])

  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  deadline    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks Task[]

  @@index([userId, status])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  ACTIVE
  PARKED
  COMPLETED
  PAUSED
  ABANDONED
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  goalId    String?
  goal      Goal?    @relation(fields: [goalId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)

  taskType       TaskType @default(BOOLEAN)
  targetCount    Int?
  completedCount Int      @default(0)
  targetMinutes  Int?

  dueDate DateTime?

  isRecurring Boolean     @default(false)
  recurrence  Recurrence?

  source   TaskSource @default(MANUAL)
  sourceId String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  calendarBlocks CalendarBlock[]
  focusSessions  FocusSession[]

  @@index([userId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  BOOLEAN
  COUNT
  TIMER
}

enum TaskSource {
  MANUAL
  DUMP
  LEARN
  BACKLOG_REMINDER
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Habit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  habitType     HabitType @default(BOOLEAN)
  targetCount   Int?
  targetMinutes Int?

  frequency    HabitFrequency @default(DAILY)
  weeklyTarget Int?
  specificDays String[]

  reminderTime String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  logs           HabitLog[]
  calendarBlocks CalendarBlock[]
  focusSessions  FocusSession[]

  @@index([userId])
}

model HabitLog {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  completed Boolean  @default(false)
  count     Int      @default(0)
  minutes   Int      @default(0)
  notes     String?

  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId])
}

enum HabitType {
  BOOLEAN
  COUNT
  TIMER
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

model Topic {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  title        String
  description  String?
  masteryLevel MasteryLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  notebooks Notebook[]
  resources Resource[]
  notes     Note[]
  documents Document[]

  @@index([userId])
}

model Notebook {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  title       String
  description String?
  tags        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  notes     Note[]
  documents Document[]

  @@index([userId])
}

model Resource {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  title        String
  resourceType ResourceType
  url          String?
  platform     String?
  status       ResourceStatus @default(NOT_STARTED)
  rating       Int?
  notes        String?

  // B8 — progress tracking
  totalLessons     Int?
  lessonsCompleted Int  @default(0)
  minutesConsumed  Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  linkedNotes Note[]

  @@index([userId])
}

model Note {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  notebookId String?
  notebook   Notebook? @relation(fields: [notebookId], references: [id])
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id])

  title    String
  content  String
  noteType NoteType @default(CONCEPT)
  tags     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  insightReviews InsightReview[]

  @@index([userId])
}

enum MasteryLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ResourceType {
  BOOK
  COURSE
  VIDEO
  ARTICLE
  PODCAST
  DOCUMENTATION
  OTHER
}

enum ResourceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NoteType {
  CONCEPT
  INSIGHT
  SUMMARY
  QUOTE
  OTHER
}

model VaultItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  content     String
  vaultType   VaultType
  mediaType   MediaType @default(TEXT)
  url         String?
  triggerTags String[]

  usedCount    Int @default(0)
  helpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum VaultType {
  REFLECTION
  MEMORY
  MOTIVATION
  RECOVERY
}

enum MediaType {
  TEXT
  QUOTE
  VIDEO
  AUDIO
  IMAGE
}

model Capture {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // For media captures rawText starts empty and is filled with the AI
  // transcript/description once background classification runs.
  rawText     String
  detectedUrl String?
  urlMetadata Json?

  // Input modality. TEXT keeps the original behaviour; IMAGE/AUDIO captures
  // carry a mediaUrl pointing at the stored file.
  mediaType MediaType @default(TEXT)
  mediaUrl  String?

  worthCheck  WorthCheck?
  worthReason String?

  suggestedOutputs Json?
  createdOutputs   Json?

  status     CaptureStatus @default(PENDING)
  confidence Float?

  createdAt DateTime @default(now())

  @@index([userId, status])
}

enum CaptureStatus {
  PENDING
  CONVERTED
  DISMISSED
}

enum WorthCheck {
  WORTH_NOW
  SAVE_LATER
  NOT_RELEVANT
}

// A large body of reference text the user pastes or uploads (e.g. a fitness
// handbook, GATE notes, a business guide). On create it's split into
// DocumentChunk rows and each chunk is embedded, so the user can later ask
// questions answered from THEIR own material (retrieval-augmented Q&A).
model Document {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional organisation: file a document under a learning Topic / Notebook.
  topicId    String?
  topic      Topic?    @relation(fields: [topicId], references: [id])
  notebookId String?
  notebook   Notebook? @relation(fields: [notebookId], references: [id])

  title      String
  sourceType DocumentSourceType @default(PASTED)
  // PENDING while chunk+embed runs in the background; READY once queryable;
  // FAILED if ingestion errored (error holds the reason).
  status     DocumentStatus     @default(PENDING)
  rawText    String
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chunks      DocumentChunk[]
  suggestions DocumentSuggestion[]

  @@index([userId])
}

// One retrievable slice of a Document. `embedding` is the chunk's vector
// (text-embedding-004, 768 dims) stored as a plain double[]; similarity is
// computed in-process (no pgvector yet — fine at personal scale).
model DocumentChunk {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  index     Int // position within the document (0-based)
  heading   String? // nearest section heading, for display + context
  content   String
  embedding Float[]

  createdAt DateTime @default(now())

  @@index([userId, documentId])
}

enum DocumentSourceType {
  PASTED
  UPLOADED
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

// An actionable item the AI proposed from a Document (phase 2: Structure). The
// user reviews these and accepts the good ones, which creates a real
// Task/Habit/Goal linked back to the source document. Kept as its own row (not
// created immediately) so the user confirms before anything lands in their
// system — AI proposes ~12, the user keeps the few that matter.
model DocumentSuggestion {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  itemType      SuggestionType
  title         String
  detail        String? // short rationale / description
  confidence    Float          @default(0.7)
  sourceHeading String? // the document section it came from
  // Type-specific fields (frequency, targetMinutes, priority, dueDate) plus the
  // resolved suggestedAreaId/Name, kept as JSON so the model stays flat.
  meta          Json?

  status SuggestionStatus @default(PENDING)
  // Set on accept — points at the created Task/Habit/Goal.
  createdEntityType String?
  createdEntityId   String?

  createdAt DateTime @default(now())

  @@index([userId, documentId])
}

enum SuggestionType {
  HABIT
  GOAL
  TASK
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum KnowledgeSourceType {
  NOTE
  RESOURCE
}

// A retrievable, embedded slice of a Note or Resource, mirroring DocumentChunk
// but for content that has no async ingest step (re-embedded synchronously
// whenever the source is written). sourceTitle is denormalized from the parent
// Note/Resource so ask results can be labeled without a second cross-table join.
model KnowledgeChunk {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType  KnowledgeSourceType
  sourceId    String
  sourceTitle String
  heading     String?
  content     String
  embedding   Float[]

  createdAt DateTime @default(now())

  @@index([userId, sourceType, sourceId])
  @@index([userId])
}

model Review {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewType  ReviewType
  periodStart DateTime
  periodEnd   DateTime

  summary      String?
  highlights   String?
  improvements String?
  userNote     String?
  aiInsights   Json?

  createdAt DateTime @default(now())

  // Relations
  insightReviews InsightReview[]

  @@index([userId])
}

model InsightReview {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  noteId   String
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  status   InsightReviewStatus @default(PENDING)
  userNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum ReviewType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum InsightReviewStatus {
  PENDING
  IMPLEMENTED
  STILL_WORKING
  NOT_APPLICABLE
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // B9 — UI personalisation
  vibe     String @default("calm") // calm | focused | energetic
  accent   String @default("#6366f1") // hex colour
  font     String @default("inter") // inter | mono | serif
  startTab String @default("today") // today | areas | dump

  // Optional modules the user has enabled. Empty == all optional modules on
  // (so existing rows and brand-new accounts behave identically). Core modules
  // (areas/tasks/capture) are always on and never stored here.
  enabledModules String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AreaScoreSnapshot {
  id     String @id @default(cuid())
  userId String
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  score      Float
  tasksDone  Int
  tasksTotal Int
  streak     Int
  focusMins  Int

  snapshotAt DateTime @default(now())

  @@index([userId])
}

model BehaviorLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType  BehaviorEvent
  metadata   Json?
  occurredAt DateTime      @default(now())

  @@index([userId])
}

enum BehaviorEvent {
  APP_OPEN
  TASK_COMPLETED
  TASK_DEFERRED
  HABIT_LOGGED
  CAPTURE_CREATED
  VAULT_ACCESSED
  FOCUS_STARTED
  FOCUS_COMPLETED
  FOCUS_ABANDONED
  AREA_VIEWED
  REVIEW_OPENED
  DOCUMENT_INGESTED
  QUESTION_ASKED
  SUGGESTIONS_EXTRACTED
}

model CalendarBlock {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId  String?
  task    Task?   @relation(fields: [taskId], references: [id])
  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id])
  areaId  String?
  area    Area?   @relation(fields: [areaId], references: [id])

  title     String
  startTime DateTime
  endTime   DateTime
  blockType String   @default("FOCUS")
  isActual  Boolean  @default(false)
  notes     String?

  // Recurrence: when set, this row is a *template*. startTime/endTime define the
  // first occurrence and the duration; recurrenceRule is an iCal RRULE string
  // (e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR"). Occurrences are expanded virtually at
  // list time and never stored as rows. Null = a one-off block.
  recurrenceRule String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  focusSessions FocusSession[]
  exceptions    CalendarBlockException[]

  @@index([userId, startTime])
}

// Per-occurrence override for a recurring CalendarBlock. Identified by the
// parent template + the occurrence's original start instant (occurrenceDate).
// isCancelled skips the occurrence entirely; the optional fields override the
// expanded values for that single occurrence.
model CalendarBlockException {
  id             String        @id @default(cuid())
  blockId        String
  block          CalendarBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime

  isCancelled Boolean   @default(false)
  title       String?
  startTime   DateTime?
  endTime     DateTime?
  blockType   String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockId, occurrenceDate])
}

model FocusSession {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id])
  habitId         String?
  habit           Habit?         @relation(fields: [habitId], references: [id])
  calendarBlockId String?
  calendarBlock   CalendarBlock? @relation(fields: [calendarBlockId], references: [id])

  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  notes           String?

  createdAt DateTime @default(now())

  @@index([userId, startedAt])
}

// A directed, meaning-carrying connection between any two owned entities —
// the "web" that sits alongside the strict Area→Goal→Project→Task spine.
//
// Why polymorphic (from/to type+id) instead of more FK columns on Task:
// a single table lets a Task link to any number of Resources/Topics/Notes
// (and later anything↔anything, powering Graph) without a migration per new
// pairing. The trade: `toId`/`fromId` are NOT real foreign keys, so existence
// + ownership is enforced in link.service.ts, not by the DB. The strict spine
// FKs on Task stay exactly as they were — this is additive.
//
// `role` is what makes progress roll-up possible: only ADVANCES links count
// toward a target's progress (a completed task advancing a Resource's
// lessonsCompleted, or a Goal's derived % done); REFERENCES links are pure
// context ("I consulted this note while doing the task").
model EntityLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromType EntityType
  fromId   String
  toType   EntityType
  toId     String

  role   LinkRole @default(REFERENCES)
  // Optional roll-up weight, e.g. "this task is worth 3 lessons". null == 1.
  weight Int?

  createdAt DateTime @default(now())

  // One link per (direction, role) between the same two entities.
  @@unique([userId, fromType, fromId, toType, toId, role])
  // Forward lookup: "what does this task link to?"
  @@index([userId, fromType, fromId])
  // Reverse lookup: "what tasks advance this resource/goal?"
  @@index([userId, toType, toId])
}

enum EntityType {
  TASK
  GOAL
  PROJECT
  RESOURCE
  TOPIC
  NOTE
  HABIT
  VAULT
  DOCUMENT
}

enum LinkRole {
  ADVANCES
  REFERENCES
}
